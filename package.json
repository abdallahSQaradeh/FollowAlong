{
  "name": "followalong",
  "displayName": "FollowAlong",
  "description": "Follow a local coding Course step by step without leaving VS Code.",
  "version": "0.0.0",
  "private": true,
  "publisher": "followalong",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/abdallahSQaradeh/FollowAlong.git"
  },
  "categories": [
    "Education"
  ],
  "engines": {
    "vscode": "^1.146.0",
    "node": ">=22.22.1"
  },
  "main": "./out/extension.js",
  "files": [
    "out/extension.js",
    "out/player/player.js",
    "out/player/player.css",
    "media/followalong.svg"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "followalong.openCourse",
        "title": "Open Course…",
        "category": "FollowAlong"
      },
      {
        "command": "followalong.playLesson",
        "title": "Play Lesson",
        "category": "FollowAlong"
      },
      {
        "command": "followalong.playPause",
        "title": "Play/Pause",
        "category": "FollowAlong"
      },
      {
        "command": "followalong.seekBackShort",
        "title": "Back (Short Step)",
        "category": "FollowAlong"
      },
      {
        "command": "followalong.seekForwardShort",
        "title": "Forward (Short Step)",
        "category": "FollowAlong"
      },
      {
        "command": "followalong.seekBackLong",
        "title": "Back (Long Step)",
        "category": "FollowAlong"
      },
      {
        "command": "followalong.seekForwardLong",
        "title": "Forward (Long Step)",
        "category": "FollowAlong"
      },
      {
        "command": "followalong.speedUp",
        "title": "Speed up",
        "category": "FollowAlong"
      },
      {
        "command": "followalong.speedDown",
        "title": "Speed down",
        "category": "FollowAlong"
      },
      {
        "command": "followalong.goToLesson",
        "title": "Go to Lesson…",
        "category": "FollowAlong"
      },
      {
        "command": "followalong.attachResource",
        "title": "Attach Resource",
        "category": "FollowAlong",
        "icon": "$(add)"
      },
      {
        "command": "followalong.openResource",
        "title": "Open Resource",
        "category": "FollowAlong"
      }
    ],
    "keybindings": [
      {
        "command": "followalong.playPause",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space",
        "when": "(editorTextFocus || terminalFocus) && !suggestWidgetVisible && !terminalSuggestWidgetVisible"
      },
      {
        "command": "followalong.playPause",
        "key": "ctrl+' space",
        "mac": "cmd+' space",
        "when": "editorTextFocus || terminalFocus"
      },
      {
        "command": "followalong.seekBackShort",
        "key": "ctrl+alt+left",
        "mac": "ctrl+cmd+left",
        "when": "editorTextFocus || terminalFocus"
      },
      {
        "command": "followalong.seekForwardShort",
        "key": "ctrl+alt+right",
        "mac": "ctrl+cmd+right",
        "when": "editorTextFocus || terminalFocus"
      },
      {
        "command": "followalong.seekBackShort",
        "key": "ctrl+' ,",
        "mac": "cmd+' ,",
        "when": "editorTextFocus || terminalFocus"
      },
      {
        "command": "followalong.seekForwardShort",
        "key": "ctrl+' .",
        "mac": "cmd+' .",
        "when": "editorTextFocus || terminalFocus"
      },
      {
        "command": "followalong.seekBackLong",
        "key": "ctrl+' left",
        "mac": "cmd+' left",
        "when": "editorTextFocus || terminalFocus"
      },
      {
        "command": "followalong.seekForwardLong",
        "key": "ctrl+' right",
        "mac": "cmd+' right",
        "when": "editorTextFocus || terminalFocus"
      },
      {
        "command": "followalong.speedUp",
        "key": "ctrl+' up",
        "mac": "cmd+' up",
        "when": "editorTextFocus || terminalFocus"
      },
      {
        "command": "followalong.speedDown",
        "key": "ctrl+' down",
        "mac": "cmd+' down",
        "when": "editorTextFocus || terminalFocus"
      },
      {
        "command": "followalong.goToLesson",
        "key": "ctrl+' l",
        "mac": "cmd+' l",
        "when": "editorTextFocus || terminalFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "followalong",
          "title": "FollowAlong",
          "icon": "media/followalong.svg"
        }
      ]
    },
    "views": {
      "followalong": [
        {
          "id": "followalong.lessons",
          "name": "Lessons"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "followalong.lessons",
        "contents": "Open a Course folder to list its Lessons here.\n[Open Course…](command:followalong.openCourse)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "followalong.playLesson",
          "when": "false"
        },
        {
          "command": "followalong.attachResource",
          "when": "false"
        },
        {
          "command": "followalong.openResource",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "followalong.attachResource",
          "when": "view == followalong.lessons && viewItem == lesson",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "FollowAlong",
      "properties": {
        "followalong.shortStep": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "markdownDescription": "Seconds the short step moves back or forward: `Ctrl+Alt+←` / `→`, `Ctrl+'` then `,` / `.`."
        },
        "followalong.longStep": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "markdownDescription": "Seconds the long step moves back or forward: `Ctrl+'` then `←` / `→`."
        }
      }
    }
  },
  "scripts": {
    "prepare": "husky",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/run-logged.mjs test -- vitest run",
    "test:player": "node scripts/run-logged.mjs test:player -- playwright test --trace off",
    "test:smoke": "node scripts/run-logged.mjs test:smoke -- node scripts/run-smoke.mjs",
    "check-logs": "node scripts/check-logs.mjs",
    "verify:fast": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "verify": "npm run verify:fast && npm run test:player && npm run test:smoke && npm run check-logs"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/vscode": "1.146.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
